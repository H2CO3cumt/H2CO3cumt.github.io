---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
// 只有一节的文章不需要目录
const items = headings.filter((h) => h.depth === 2);
---

{
  items.length >= 2 && (
    <nav class="toc" aria-label="本页目录">
      <p class="toc-title">目录</p>
      <ul>
        {items.map((h) => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
