---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byYear = new Map<number, typeof notes>();
for (const note of notes) {
  const year = note.data.date.getFullYear();
  const bucket = byYear.get(year) ?? [];
  bucket.push(note);
  byYear.set(year, bucket);
}

const years = [...byYear.keys()].sort((a, b) => b - a);
const day = (d: Date) => `${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<Base title="归档" description="全部随笔，按年份倒序。" section="notes">
  <section class="entry-head">
    <h1>归档</h1>
    <p class="byline">全部随笔，按年份倒序。技术笔记和生活记录不分开排。</p>
  </section>

  {
    years.map((year) => (
      <section class="section">
        <h2>{year}</h2>
        <ul class="entries">
          {byYear.get(year)!.map((note) => (
            <li>
              <span class="when">{day(note.data.date)}</span>
              <p class="what">
                <a href={`/notes/${note.id}/`}>{note.data.title}</a>
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {years.length === 0 && <p class="quiet">还没有写过东西。</p>}
</Base>
