---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byTag = new Map<string, typeof notes>();
for (const note of notes) {
  for (const tag of note.data.tags) {
    const bucket = byTag.get(tag) ?? [];
    bucket.push(note);
    byTag.set(tag, bucket);
  }
}

// 出现次数多的在前，同频按拼音/字面排
const tags = [...byTag.entries()].sort(
  (a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0], 'zh'),
);

const stamp = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<Base title="标签" description="全部随笔按标签归类。" section="notes">
  <section class="entry-head">
    <h1>标签</h1>
    <p class="byline">同一个东西写多了才会成标签。也可以<a href="/archive/">按年份翻</a>。</p>
  </section>

  {
    tags.map(([tag, list]) => (
      <section class="section">
        <h2 id={tag}>{tag}</h2>
        <ul class="entries">
          {list.map((note) => (
            <li>
              <span class="when">{stamp(note.data.date)}</span>
              <p class="what">
                <a href={`/notes/${note.id}/`}>{note.data.title}</a>
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {tags.length === 0 && <p class="quiet">还没有带标签的随笔。</p>}
</Base>
